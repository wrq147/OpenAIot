import { IOSTcpClient } from "tcp-client";
import { ConnectorOptions, TcpConnector } from '../interface.uts';
import { ConnectorFailImpl } from '../unierror';

class IosTcpState {
    client: IOSTcpClient | null = null;
    onMessage: ((data: ArrayBuffer) => void) | null = null;
    onClose: (() => void) | null = null;
    constructor() {}
}

const iosStateMap = new Map<number, IosTcpState>();
let iosNextId: number = 0;

export const qzTcp: TcpConnector = function (options: ConnectorOptions): number {
    iosNextId = iosNextId + 1;
    const id = iosNextId;
    const state = new IosTcpState();
    state.onMessage = options.onMessage as ((data: ArrayBuffer) => void) | null;
    state.onClose = options.onClose as (() => void) | null;
    iosStateMap.set(id, state);

    setTimeout(() => {
        try {
            const client = new IOSTcpClient(options.address, options.port.toInt());
            client.connect();
            client.setDataReceivedCallback((data: Data) => {
                const cb = state.onMessage;
                if (cb != null && data != null) {
                    cb.invoke(ArrayBuffer.fromData(data));
                }
            });
            client.setDisconnectCallback(() => {
                const cb = state.onClose;
                if (cb != null) cb.invoke();
                iosStateMap.remove(id);
            });
            state.client = client;
            options.success?.invoke();
        } catch (err) {
            const failErr = new ConnectorFailImpl(902001, "TCP连接失败: " + err);
            options.fail?.invoke(failErr);
            iosStateMap.remove(id);
        }
    }, 10);

    return id;
};

export const tcpWrite = function (id: number, data: ArrayBuffer): void {
    const state = iosStateMap.get(id);
    if (state == null || state.client == null) return;
    state.client.send(data.toData());
};

export const tcpWriteString = function (id: number, data: string): void {
    const state = iosStateMap.get(id);
    if (state == null || state.client == null) return;
    const encoder = new TextEncoder();
    const byteArray: Uint8Array = encoder.encode(data);
    state.client.send(byteArray.buffer.toData());
};

export const tcpClose = function (id: number): void {
    const state = iosStateMap.get(id);
    if (state == null || state.client == null) return;
    state.client.disconnect();
    iosStateMap.remove(id);
};
