<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AirJointUI.Component">
	<Design.PreviewWith>
		<controls:SwitchButton />
	</Design.PreviewWith>
	<Style Selector="controls|SwitchButton">
		<!-- Set Defaults -->
		<Setter Property="Template">
			<ControlTemplate>
				<Border Name="SwitchBG"
							Width="{TemplateBinding Width}"
							Height="{TemplateBinding Height}"
							Background="#F1F2F6"
							BorderThickness="0"
							CornerRadius="34">
					<StackPanel Orientation="Horizontal">
						<!--文本-->
						<TextBlock x:Name="CloseText" Margin="65 12 65 12" Foreground="#999" VerticalAlignment="Center" FontSize="20" Text="{TemplateBinding ContentTrue}">
						</TextBlock>
						<!--圆形-->
						<Border x:Name="state" Margin="0,4,4,4" CornerRadius="34"
							Background="#FFFFFF">
							<TextBlock Margin="65 12 65 12" x:Name="OpenText" Foreground="#333" VerticalAlignment="Center" FontSize="20" Text="{TemplateBinding ContentFalse}">
							</TextBlock>
						</Border>
					</StackPanel>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="controls|SwitchButton:checked">
		<!-- Set Defaults -->
		<Setter Property="Template">
			<ControlTemplate>
				<Border Name="SwitchBG"
							Width="{TemplateBinding Width}"
							Height="{TemplateBinding Height}"
							Background="#F1F2F6"
							BorderThickness="0"
							CornerRadius="34">
					<StackPanel Orientation="Horizontal">
						<!--圆形-->
						<Border x:Name="state" Margin="4,4,0,4" CornerRadius="34"
							Background="#FFFFFF">
							<TextBlock Margin="65 12 65 12" x:Name="OpenText" Foreground="#333" VerticalAlignment="Center" FontSize="20" Text="{TemplateBinding ContentTrue}">
							</TextBlock>
						</Border>

						<!--文本-->
						<TextBlock x:Name="CloseText" Margin="65 12 65 12" Foreground="#999" VerticalAlignment="Center" FontSize="20" Text="{TemplateBinding ContentFalse}">
						</TextBlock>
					</StackPanel>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
</Styles>
