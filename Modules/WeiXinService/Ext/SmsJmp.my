<!DOCTYPE html>

<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <style>
        html {
            font-size: 14px;
            background-color: #fff;
        }

        body {
            background-color: #fff;
        }
    </style>
    <title></title>
</head>
<body>
    <div style="padding:150px 16px 0 16px;">
        <div style="padding-bottom: 20px; color: #999;text-align:center;">提示:无法自动跳转则点击按钮跳转</div>
        <div style="display: flex; justify-content: center;">
            <a id="xhre" href="" style="display:flex; width:180px;height:50px;justify-content:center;align-items:center;border:solid 1px #0094ff;">立即打开</a>
        </div>
    </div>

    <script type="text/javascript">
    var tick = getUrlParam("t");
    var linkurl = 'weixin://dl/business/?t=' + tick;
    location.href = linkurl;
    document.getElementById("xhre").href = linkurl;
    </script>
</body>
</html>